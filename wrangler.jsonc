{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "binary-liuyao",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-25",
  "vars": {
    "COUNTER_MAX_PER_MINUTE": "30",
    "COUNTER_MAX_PER_HOUR": "200",
    "COUNTER_MAX_PER_DAY": "500"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hex64-counter",
      "database_id": "01e38e84-0157-4518-a324-f9b1950b2faa"
    }
  ]
}
